{
  "name": "openpromises",
  "private": true,
  "description": "One open engine for tracking what people in power promise",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "schema": "pnpm --filter @openpromises/core schema",
    "openpromises": "node packages/cli/dist/bin.js"
  },
  "devDependencies": {
    "@openpromises/cli": "workspace:*",
    "@openpromises/core": "workspace:*",
    "@openpromises/files": "workspace:*",
    "@openpromises/quotes": "workspace:*",
    "@types/node": "22.20.4",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
