{
  "name": "@openpromises/publish",
  "version": "0.3.0",
  "description": "Publishing for OpenPromises: Atom and RSS feeds, JSON-LD, Markdown, llms.txt, sitemap, open data and IndexNow change lists, built from cards",
  "keywords": [
    "promises",
    "accountability",
    "fact-checking",
    "journalism",
    "open-data",
    "politics",
    "yaml"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://github.com/xternal/openpromises#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xternal/openpromises.git",
    "directory": "packages/publish"
  },
  "bugs": {
    "url": "https://github.com/xternal/openpromises/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@openpromises/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
