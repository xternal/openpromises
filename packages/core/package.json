{
  "name": "@openpromises/core",
  "version": "0.3.0",
  "description": "OpenPromises card format v1, configuration and rules: pure functions, no I/O",
  "keywords": [
    "promises",
    "accountability",
    "fact-checking",
    "journalism",
    "open-data",
    "politics",
    "yaml"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://github.com/xternal/openpromises#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xternal/openpromises.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/xternal/openpromises/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/*": "./schema/*"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "schema": "node scripts/json-schema.mjs"
  },
  "dependencies": {
    "@openpromises/quotes": "workspace:*",
    "zod": "4.6.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
