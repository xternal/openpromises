{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xternal/openpromises/main/packages/core/schema/config.schema.json",
  "title": "OpenPromises config",
  "description": "An OpenPromises site configuration in YAML or JSON (docs/FORMAT.md §2). The x schemas are TypeScript only.",
  "type": "object",
  "properties": {
    "site": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "description": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "paths": {
          "type": "object",
          "properties": {
            "promises": {
              "type": "string",
              "pattern": "^\\/[^\\s]*$"
            },
            "card": {
              "type": "string",
              "pattern": "^\\/[^\\s]*$"
            },
            "actor": {
              "type": "string",
              "pattern": "^\\/[^\\s]*$"
            },
            "area": {
              "type": "string",
              "pattern": "^\\/[^\\s]*$"
            },
            "feeds": {
              "type": "string",
              "pattern": "^(\\/[^\\s]*|\\{page\\}[^\\s]*)$"
            }
          },
          "additionalProperties": false
        },
        "localePaths": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^(\\/[A-Za-z0-9-]+)*$"
          }
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "locales": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "all": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          }
        }
      },
      "required": [
        "default",
        "all"
      ],
      "additionalProperties": false
    },
    "money": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "unit": {
          "type": "string"
        },
        "period": {
          "type": "string",
          "enum": [
            "year",
            "month",
            "total"
          ]
        },
        "qualities": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,59}$"
          }
        }
      },
      "required": [
        "currency"
      ],
      "additionalProperties": false
    },
    "actors": {
      "type": "object",
      "properties": {
        "kinds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,59}$"
          }
        },
        "standing": {
          "type": "string",
          "enum": [
            "manual",
            "fromSeats",
            "none"
          ]
        },
        "levels": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ids": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,59}$"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "venues": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,59}$"
      }
    },
    "areas": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "enum"
            },
            "values": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "labels": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "slugs": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,98}[a-z0-9])?$"
              }
            }
          },
          "required": [
            "kind",
            "values"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "codes"
            },
            "pattern": {
              "type": "string",
              "minLength": 1
            },
            "labels": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "slugs": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,98}[a-z0-9])?$"
              }
            }
          },
          "required": [
            "kind",
            "pattern"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ladder": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "national",
            "local"
          ]
        },
        {
          "type": "object",
          "properties": {
            "custom": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,59}$"
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "open",
                      "progress",
                      "finished",
                      "off_ladder"
                    ]
                  }
                },
                "required": [
                  "id",
                  "category"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "custom"
          ],
          "additionalProperties": false
        }
      ]
    },
    "labels": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        ]
      }
    },
    "headline": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "minWords": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maxWords": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "minChars": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maxChars": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "additionalProperties": false
      }
    },
    "editorial": {
      "type": "object",
      "properties": {
        "approvals": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        },
        "partyConflict": {
          "type": "boolean",
          "const": true
        },
        "editorsFile": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "const": "in-file"
        }
      },
      "additionalProperties": false
    },
    "quotes": {
      "type": "object",
      "properties": {
        "archive": {
          "type": "string",
          "enum": [
            "required",
            "optional"
          ]
        },
        "require": {
          "type": "string",
          "enum": [
            "editor",
            "match"
          ]
        },
        "normalise": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "minWords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "contracts",
          "decisions",
          "lever",
          "metrics",
          "designations",
          "wards",
          "corrections",
          "reviews"
        ]
      }
    },
    "legacy": {
      "type": "string",
      "enum": [
        "public-ledger",
        "borough-book",
        "russia-ledger"
      ]
    },
    "deadlines": {
      "type": "object",
      "properties": {
        "text": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "lint": {
      "type": "object",
      "properties": {
        "words": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allow": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "additionalProperties": false
    },
    "messages": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "publish": {
      "type": "object",
      "properties": {
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.-]+,\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        "feeds": {
          "type": "string",
          "enum": [
            "atom",
            "rss",
            "both"
          ]
        },
        "licence": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "name",
            "url"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "x": {
      "type": "object",
      "properties": {
        "card": {},
        "actor": {}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "site"
  ],
  "additionalProperties": false
}
