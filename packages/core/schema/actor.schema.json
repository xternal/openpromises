{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xternal/openpromises/main/packages/core/schema/actor.schema.json",
  "title": "OpenPromises actor",
  "description": "An OpenPromises actor, format openpromises/1 (docs/FORMAT.md §11).",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "openpromises/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,98}[a-z0-9])?$"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,59}$"
    },
    "name": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "short_name": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "party_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,98}[a-z0-9])?$"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "from": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "to": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "source": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "quote": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      }
    },
    "standing": {
      "type": "string",
      "enum": [
        "in_power",
        "opposition",
        "public_body"
      ]
    },
    "level": {
      "type": "string",
      "pattern": "\\S"
    },
    "seats": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "identifiers": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,59}$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "\\S"
          },
          {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        ]
      }
    },
    "same_as": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "same_as_checked_on": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "x": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "format",
    "id",
    "kind",
    "name"
  ],
  "additionalProperties": false
}
