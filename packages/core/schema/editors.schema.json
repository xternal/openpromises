{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/xternal/openpromises/main/packages/core/schema/editors.schema.json",
  "title": "OpenPromises editors",
  "description": "An OpenPromises editors list (docs/FORMAT.md §12).",
  "type": "object",
  "properties": {
    "editors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string",
            "pattern": "^\\S(?:.{0,38}\\S)?$"
          },
          "since": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "until": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "party": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,98}[a-z0-9])?$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "handle",
          "since",
          "party"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "editors"
  ],
  "additionalProperties": false
}
