      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@openpromises/core": "workspace:*",
    "@openpromises/files": "workspace:*",
    "@openpromises/quotes": "workspace:*"
  },
  "bin": {
    "openpromises": "./dist/bin.js"
  }
