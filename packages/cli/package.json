{
  "name": "@openpromises/cli",
  "version": "0.0.0",
  "private": true,
  "description": "The openpromises command: validate, new, review, check-quote, deadlines, lint, migrate, stats",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xternal/openpromises.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
